{
  "title": "lab.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "visibility": {
      "type": "string",
      "enum": ["listed", "unlisted", "draft"]
    },
    "kind": {
      "default": "interactive",
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 500
    },
    "tags": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "year": {
      "type": "integer",
      "minimum": 1990,
      "maximum": 2100
    },
    "thumbnail": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "default": "index.html",
      "type": "string",
      "minLength": 1
    },
    "spa": {
      "default": false,
      "type": "boolean"
    },
    "crossOriginIsolated": {
      "default": false,
      "type": "boolean"
    },
    "outDir": {
      "default": ".",
      "type": "string"
    },
    "exclude": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["slug", "title", "visibility"],
  "additionalProperties": false
}
