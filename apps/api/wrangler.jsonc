{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aninir-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Reached only through the edge Worker (service binding), never directly.
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aninir",
      // Replace with the id printed by `wrangler d1 create aninir`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "LAB_BUCKET", "bucket_name": "aninir-lab" }]
  // Secret: LAB_DEPLOY_TOKEN (`wrangler secret put LAB_DEPLOY_TOKEN`, or .dev.vars locally).
}
